# ==============================================================================
# IncidentHub Root .gitignore
# ==============================================================================

# Node / Frontend
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
backend/.venv/
**/backend/.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Files (Protect secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!**/.env.example

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
coverage/
.vitest/
*.lcov

# Type Checking & Linters
.mypy_cache/
.ruff_cache/
.eslintcache

# Database & Local Storage
*.sqlite
*.sqlite3
postgres_data/

# Docker / Local Artifacts
docker-compose.override.yml
*.log

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
