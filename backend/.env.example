# IncidentHub Backend Environment Variables (Development Example)
# Copy to .env for local overrides. Do not commit actual secrets.

PROJECT_NAME="IncidentHub"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS (JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incidenthub

# Optional full DATABASE_URL override (if set, overrides individual POSTGRES_* settings)
# For asyncpg: postgresql+asyncpg://postgres:postgres@localhost:5432/incidenthub
# For psycopg2/Alembic: postgresql://postgres:postgres@localhost:5432/incidenthub
DATABASE_URL=
