# ==============================================================================
# IncidentHub Environment Variables Template (.env.example)
#
# Copy this file to .env for local Docker Compose and development execution.
# NEVER commit production credentials or sensitive secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
POSTGRES_DB=incidenthub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional full Database URL override (e.g., for external database)
DATABASE_URL=

# Backend Service
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
